{
	"name": "${localWorkspaceFolderBasename}",
	"dockerComposeFile": [
		"../compose.yaml",
		"docker-compose.yml"
	],
	"service": "app",
	"workspaceFolder": "/home/node/app",
	"postStartCommand": "yarn install --immutable && yarn start",
	"customizations": {
		"vscode": {
			"extensions": [
				"unifiedjs.vscode-mdx",
				"yzhang.markdown-all-in-one",
				"esbenp.prettier-vscode"
			]
		}
	}
}